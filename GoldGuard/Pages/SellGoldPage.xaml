<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoldGuard.Pages.SellGoldPage"
             Title="بيع ذهب"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Frame Grid.Row="0" BackgroundColor="#DC3545" Padding="15" Margin="0" HasShadow="False">
            <Label Text="💰 بيع ذهب" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="White"
                   HorizontalOptions="Center"/>
        </Frame>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15" Spacing="15">
                
                <!-- Karat Selection -->
                <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="عيار الذهب" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                        <Picker x:Name="KaratPicker" Title="اختر العيار" SelectedIndexChanged="OnKaratChanged">
                            <Picker.Items>
                                <x:String>24</x:String>
                                <x:String>22</x:String>
                                <x:String>21</x:String>
                                <x:String>18</x:String>
                                <x:String>14</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </Frame>

                <!-- Price Per Gram -->
                <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="سعر جرام الذهب الحالي (جنيه)" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                        <Entry x:Name="PricePerGramEntry" 
                               Placeholder="سعر الجرام" 
                               Keyboard="Numeric" 
                               TextChanged="OnPriceChanged"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Weight -->
                <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="الوزن بالجرام" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                        <Entry x:Name="WeightEntry" 
                               Placeholder="الوزن بالجرام" 
                               Keyboard="Numeric" 
                               TextChanged="OnCalculationInputChanged"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Discount Percentage -->
                <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="نسبة الخصم/المصنعية (%)" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                        <Entry x:Name="DiscountEntry" 
                               Placeholder="نسبة الخصم" 
                               Keyboard="Numeric" 
                               Text="2"
                               TextChanged="OnCalculationInputChanged"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Calculate Button -->
                <Button Text="💰 احسب قيمة البيع" 
                        Clicked="OnCalculateClicked"
                        BackgroundColor="#DC3545"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"
                        CornerRadius="10"/>

                <!-- Results -->
                <Frame x:Name="ResultsFrame" 
                       BackgroundColor="#FCE4EC" 
                       CornerRadius="10" 
                       Padding="15" 
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📊 النتائج" FontSize="18" FontAttributes="Bold" TextColor="#C62828"/>
                        
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="سعر الجرام الحالي:" FontSize="14" TextColor="#333"/>
                            <Label Grid.Column="1" x:Name="OriginalPriceLabel" Text="0 جنيه" FontSize="14" FontAttributes="Bold"/>
                            
                            <Label Grid.Row="1" Grid.Column="0" Text="نسبة الخصم:" FontSize="14" TextColor="#333"/>
                            <Label Grid.Row="1" Grid.Column="1" x:Name="DiscountPercentageLabel" Text="0%" FontSize="14" FontAttributes="Bold"/>
                            
                            <Label Grid.Row="2" Grid.Column="0" Text="قيمة الخصم لكل جرام:" FontSize="14" TextColor="#333"/>
                            <Label Grid.Row="2" Grid.Column="1" x:Name="DiscountValueLabel" Text="0 جنيه" FontSize="14" FontAttributes="Bold"/>
                            
                            <Label Grid.Row="3" Grid.Column="0" Text="سعر الجرام بعد الخصم:" FontSize="14" TextColor="#333"/>
                            <Label Grid.Row="3" Grid.Column="1" x:Name="NetPriceLabel" Text="0 جنيه" FontSize="14" FontAttributes="Bold"/>
                            
                            <Label Grid.Row="4" Grid.Column="0" Text="الوزن:" FontSize="14" TextColor="#333"/>
                            <Label Grid.Row="4" Grid.Column="1" x:Name="WeightLabel" Text="0 جرام" FontSize="14" FontAttributes="Bold"/>
                            
                            <BoxView Grid.Row="5" HeightRequest="1" Color="#E53935" Margin="0,5"/>
                            
                            <Label Grid.Row="6" Grid.Column="0" Text="القيمة المتوقعة:" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                            <Label Grid.Row="6" Grid.Column="1" x:Name="TotalLabel" Text="0 جنيه" FontSize="16" FontAttributes="Bold" TextColor="#C62828"/>
                        </Grid>

                        <!-- Share Button -->
                        <Button Text="📤 مشاركة النتيجة" 
                                Clicked="OnShareClicked"
                                BackgroundColor="#007BFF"
                                TextColor="White"
                                FontSize="14"
                                CornerRadius="8"
                                Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Shop Price Comparison -->
                <Frame x:Name="ComparisonFrame" 
                       BackgroundColor="#FFF3CD" 
                       CornerRadius="10" 
                       Padding="15" 
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🏪 المحل عرض عليك كام؟" FontSize="16" FontAttributes="Bold" TextColor="#856404"/>
                        
                        <Entry x:Name="ShopPriceEntry" 
                               Placeholder="السعر الذي عرضه المحل" 
                               Keyboard="Numeric"/>
                        
                        <Button Text="⚖️ قارن الأسعار" 
                                Clicked="OnCompareClicked"
                                BackgroundColor="#FFC107"
                                TextColor="#333"
                                FontSize="14"
                                CornerRadius="8"/>
                        
                        <Label x:Name="ComparisonResultLabel" 
                               Text="" 
                               FontSize="14" 
                               TextColor="#333"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Back Button -->
        <Button Grid.Row="2" 
                Text="← رجوع" 
                Clicked="OnBackClicked"
                BackgroundColor="#6C757D"
                TextColor="White"
                FontSize="16"
                CornerRadius="0"
                HeightRequest="50"/>
    </Grid>
</ContentPage>
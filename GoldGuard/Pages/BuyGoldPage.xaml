<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoldGuard.Pages.BuyGoldPage"
             Title="شراء ذهب"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Frame Grid.Row="0" BackgroundColor="#28A745" Padding="15" Margin="0" HasShadow="False">
            <Label Text="🛒 شراء ذهب" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="White"
                   HorizontalOptions="Center"/>
        </Frame>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15" Spacing="15">
                
                <!-- Karat Selection -->
                <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="عيار الذهب" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                        <Picker x:Name="KaratPicker" Title="اختر العيار" SelectedIndexChanged="OnKaratChanged">
                            <Picker.Items>
                                <x:String>24</x:String>
                                <x:String>22</x:String>
                                <x:String>21</x:String>
                                <x:String>18</x:String>
                                <x:String>14</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </Frame>

                <!-- Price Per Gram -->
                <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="سعر جرام الذهب (جنيه)" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                        <Entry x:Name="PricePerGramEntry" 
                               Placeholder="سعر الجرام" 
                               Keyboard="Numeric" 
                               TextChanged="OnPriceChanged"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Weight -->
                <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="الوزن بالجرام" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                        <Entry x:Name="WeightEntry" 
                               Placeholder="الوزن بالجرام" 
                               Keyboard="Numeric" 
                               TextChanged="OnCalculationInputChanged"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Manufacturing Percentage -->
                <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="المصنعية (%)" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                        <Entry x:Name="ManufacturingEntry" 
                               Placeholder="نسبة المصنعية" 
                               Keyboard="Numeric" 
                               Text="5"
                               TextChanged="OnCalculationInputChanged"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Stamp Fee -->
                <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="الدمغة/الرسوم (جنيه للجرام)" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                        <Entry x:Name="StampFeeEntry" 
                               Placeholder="الدمغة لكل جرام" 
                               Keyboard="Numeric" 
                               Text="10"
                               TextChanged="OnCalculationInputChanged"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Extra Fees -->
                <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="رسوم إضافية (اختياري)" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                        <Entry x:Name="ExtraFeesEntry" 
                               Placeholder="0" 
                               Keyboard="Numeric" 
                               Text="0"
                               TextChanged="OnCalculationInputChanged"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Calculate Button -->
                <Button Text="💰 احسب السعر" 
                        Clicked="OnCalculateClicked"
                        BackgroundColor="#28A745"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"
                        CornerRadius="10"/>

                <!-- Results -->
                <Frame x:Name="ResultsFrame" 
                       BackgroundColor="#E8F5E9" 
                       CornerRadius="10" 
                       Padding="15" 
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📊 النتائج" FontSize="18" FontAttributes="Bold" TextColor="#2E7D32"/>
                        
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="قيمة الذهب:" FontSize="14" TextColor="#333"/>
                            <Label Grid.Column="1" x:Name="GoldValueLabel" Text="0 جنيه" FontSize="14" FontAttributes="Bold"/>
                            
                            <Label Grid.Row="1" Grid.Column="0" Text="المصنعية:" FontSize="14" TextColor="#333"/>
                            <Label Grid.Row="1" Grid.Column="1" x:Name="ManufacturingValueLabel" Text="0 جنيه" FontSize="14" FontAttributes="Bold"/>
                            
                            <Label Grid.Row="2" Grid.Column="0" Text="الدمغة:" FontSize="14" TextColor="#333"/>
                            <Label Grid.Row="2" Grid.Column="1" x:Name="StampValueLabel" Text="0 جنيه" FontSize="14" FontAttributes="Bold"/>
                            
                            <Label Grid.Row="3" Grid.Column="0" Text="رسوم إضافية:" FontSize="14" TextColor="#333"/>
                            <Label Grid.Row="3" Grid.Column="1" x:Name="ExtraFeesLabel" Text="0 جنيه" FontSize="14" FontAttributes="Bold"/>
                            
                            <Label Grid.Row="4" Grid.Column="0" Text="متوسط سعر الجرام:" FontSize="14" TextColor="#333"/>
                            <Label Grid.Row="4" Grid.Column="1" x:Name="FinalPricePerGramLabel" Text="0 جنيه" FontSize="14" FontAttributes="Bold"/>
                            
                            <BoxView Grid.Row="5" HeightRequest="1" Color="#4CAF50" Margin="0,5"/>
                            
                            <Label Grid.Row="6" Grid.Column="0" Text="الإجمالي:" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                            <Label Grid.Row="6" Grid.Column="1" x:Name="TotalLabel" Text="0 جنيه" FontSize="16" FontAttributes="Bold" TextColor="#2E7D32"/>
                        </Grid>

                        <!-- Share Button -->
                        <Button Text="📤 مشاركة النتيجة" 
                                Clicked="OnShareClicked"
                                BackgroundColor="#007BFF"
                                TextColor="White"
                                FontSize="14"
                                CornerRadius="8"
                                Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Shop Price Comparison -->
                <Frame x:Name="ComparisonFrame" 
                       BackgroundColor="#FFF3CD" 
                       CornerRadius="10" 
                       Padding="15" 
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🏪 المحل قالك كام؟" FontSize="16" FontAttributes="Bold" TextColor="#856404"/>
                        
                        <Entry x:Name="ShopPriceEntry" 
                               Placeholder="السعر الذي طلبه المحل" 
                               Keyboard="Numeric"/>
                        
                        <Button Text="⚖️ قارن الأسعار" 
                                Clicked="OnCompareClicked"
                                BackgroundColor="#FFC107"
                                TextColor="#333"
                                FontSize="14"
                                CornerRadius="8"/>
                        
                        <Label x:Name="ComparisonResultLabel" 
                               Text="" 
                               FontSize="14" 
                               TextColor="#333"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Back Button -->
        <Button Grid.Row="2" 
                Text="← رجوع" 
                Clicked="OnBackClicked"
                BackgroundColor="#6C757D"
                TextColor="White"
                FontSize="16"
                CornerRadius="0"
                HeightRequest="50"/>
    </Grid>
</ContentPage>